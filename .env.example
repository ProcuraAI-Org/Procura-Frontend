# ProcuraAI Backend API (Procura-Backend)
# Default: http://localhost:4000
VITE_API_URL=http://localhost:4005

# Google sign-in: create OAuth 2.0 Client ID (Web) at https://console.cloud.google.com/apis/credentials
# Add the same value as GOOGLE_CLIENT_ID in the backend .env. Add authorized JavaScript origins (e.g. http://localhost:5173).
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# thirdweb client ID: create one at https://thirdweb.com/dashboard
# VITE_THIRDWEB_CLIENT_ID=<value>
